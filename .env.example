# Copy to .env and adjust.

# Which backend to search with: serper | google_cse | duckduckgo
#   serper     -> real Google results via https://serper.dev (free tier available)  [recommended]
#   google_cse -> Google Programmable Search JSON API (needs API key + engine id)
#   duckduckgo -> no key needed; fine for local development
SEARCH_PROVIDER=duckduckgo

SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

LOG_LEVEL=INFO
DEFAULT_RESULT_LIMIT=5
FETCH_TIMEOUT_SECONDS=10
MAX_CONTENT_CHARS=5000
WEB_CONCURRENCY=2
